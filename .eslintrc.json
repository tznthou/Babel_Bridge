{
  "env": {
    "browser": true,
    "es2021": true,
    "webextensions": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "no-var": "error"
  },
  "globals": {
    "chrome": "readonly"
  },
  "overrides": [
    {
      "files": ["src/lib/crypto-utils.js"],
      "globals": {
        "WorkerGlobalScope": "readonly"
      }
    },
    {
      "files": ["src/offscreen/pcm-processor.js"],
      "globals": {
        "AudioWorkletProcessor": "readonly",
        "registerProcessor": "readonly",
        "sampleRate": "readonly",
        "currentFrame": "readonly",
        "currentTime": "readonly"
      }
    }
  ]
}
